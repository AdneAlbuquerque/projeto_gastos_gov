  <step>
    <name>cria regras </name>
    <type>Janino</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>uf_tratada</field_name>
      <formula_string>(uf == null || uf.trim().isEmpty()) ? "Nacional" : uf.trim()</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>tipo_gasto</field_name>
      <formula_string>(uf == null || uf.trim().isEmpty()) ? "Nacional" : "Regional"</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>ano_emenda</field_name>
      <formula_string>(cod_autor_emenda != null &amp;&amp; cod_autor_emenda.trim().length() >= 4) ? cod_autor_emenda.trim().substring(0,4) : "Desconhecido"</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>status_registro</field_name>
      <formula_string>valor_empenhado == 0 &amp;&amp; valor_liquidado == 0 &amp;&amp; valor_pago == 0 &amp;&amp; valor_restos_pagos != 0 ? "Pago em outro periodo" : valor_empenhado == 0 &amp;&amp; valor_liquidado == 0 &amp;&amp; valor_pago == 0 &amp;&amp; valor_restos_cancelado != 0 ? "Cancelado sem execucao" : valor_empenhado == 0 &amp;&amp; valor_liquidado == 0 &amp;&amp; valor_pago == 0 ? "Sem execucao" : valor_empenhado == 0 &amp;&amp; valor_liquidado > 0 ? "Execucao sem empenho/periodo anterior" : valor_empenhado > 0 &amp;&amp; valor_liquidado == 0 &amp;&amp; valor_pago == 0 &amp;&amp; valor_restos_inscritos > 0 ? "Empenhado com restos inscritos" : valor_empenhado > 0 &amp;&amp; valor_liquidado == 0 &amp;&amp; valor_pago == 0 ? "Empenhado nao liquidado" : valor_empenhado > 0 &amp;&amp; valor_liquidado > 0 &amp;&amp; valor_pago == 0 &amp;&amp; valor_restos_pagos > 0 ? "Liquidado pago em outro periodo" : valor_empenhado > 0 &amp;&amp; valor_liquidado > 0 &amp;&amp; valor_pago == 0 ? "Liquidado nao pago" : valor_empenhado > 0 &amp;&amp; valor_liquidado == 0 &amp;&amp; valor_pago > 0 ? "Pago sem liquidacao/inconsistencia" : valor_pago > 0 &amp;&amp; valor_pago &lt; valor_liquidado &amp;&amp; valor_restos_cancelado > 0 ? "Pago parcial com cancelamento" : valor_pago > 0 &amp;&amp; valor_pago &lt; valor_liquidado ? "Pago parcial" : valor_pago >= valor_liquidado &amp;&amp; valor_restos_inscritos > 0 ? "Execucao completa com restos pendentes" : "Execucao completa"</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>municipio_tratado</field_name>
      <formula_string>(uf == null || uf.trim().isEmpty()) &amp;&amp; (municipio == null || municipio.trim().isEmpty()) ? "Nacional" : (uf != null &amp;&amp; !uf.trim().isEmpty()) &amp;&amp; (municipio == null || municipio.trim().isEmpty()) ? "Desconhecido" : municipio.trim()</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
